{
  "version": "1.9",
  "last_updated": "2026-05-19",
  "notes": "v1.9 (2026-05-19): Added the Sacramento market (Nielsen DMA 862, Sacramento-Stockton-Modesto). One zone, SAC-METRO, covering all 365 Tier 1 ZIPs across 17 counties from the Sacramento metro south to Modesto and east into the Sierra foothills. Account manager: Alex Acuna (reassigned here from the dissolved LA-NORTH zone in v1.8). Assignment is via the existing zip_assignments zip_list rule; no new rule type needed. A market_views entry and a Sacramento market button were added to index.html. zip_layer.geojson and zip_demographics.json must be regenerated to include the new ZIPs before this market renders. After Sacramento addresses appear in the Sheet, run migrateZoneIds() to assign them.",
  "zones": {
    "Chicago-CENTRAL": {
      "label": "Chicago Central",
      "market": "CHICAGO",
      "color": "#7c3aed",
      "description": "Cook/DuPage/Kane and points north of the stepped Central/South boundary (lat 41.82 most places, but boundary steps up to 41.90 along the downtown lakefront corridor and 41.86 around Berwyn)",
      "account_manager": "Elizabeth Varela"
    },
    "Chicago-SOUTH": {
      "label": "Chicago South",
      "market": "CHICAGO",
      "color": "#0891b2",
      "description": "South Chicago + NW Indiana (south of the stepped boundary). Includes downtown Chicago lakefront corridor up to lat 41.90 and Berwyn up to lat 41.86.",
      "account_manager": "Jorge Rodriguez"
    },
    "Milwaukee + N. IL": {
      "label": "Milwaukee + N. Illinois",
      "market": "MILWAUKEE",
      "color": "#be185d",
      "description": "All of Milwaukee market + Lake County IL + McHenry County IL",
      "account_manager": "Ana Lopes"
    },
    "LA-WEST": {
      "label": "LA — West Basin, Valley & Coast",
      "market": "LOS ANGELES",
      "color": "#2563eb",
      "description": "West LA basin and coast, South Bay, PV peninsula, Wilmington, Malibu, all of Long Beach, plus the San Fernando Valley, Glendale, Burbank, Santa Clarita Valley and all of Ventura County (Thousand Oaks, Oxnard, Ventura, Ojai, Simi Valley, Camarillo).",
      "account_manager": "Albert Trevino"
    },
    "LA-CENTRAL": {
      "label": "LA — Central Basin, SGV & Antelope Valley",
      "market": "LOS ANGELES",
      "color": "#9333ea",
      "description": "Central LA basin (downtown, East LA), San Gabriel Valley, Pasadena-area foothills, the LA-County east valley (Glendora, San Dimas, Claremont, Pomona, Diamond Bar), north Orange County (Anaheim, Santa Ana, Fullerton, Garden Grove, Westminster), and the Antelope Valley high desert (Lancaster, Palmdale, Acton).",
      "account_manager": "Julie Lin"
    },
    "LA-EAST": {
      "label": "LA — Inland Empire & South OC",
      "market": "LOS ANGELES",
      "color": "#ea580c",
      "description": "Inland Empire (Ontario, San Bernardino, Riverside, Fontana, Rancho Cucamonga), south Orange County (Irvine, Mission Viejo, San Juan Capistrano), the eastern Mojave high desert and Inyo County desert (Death Valley, Bishop, Lone Pine).",
      "account_manager": "Zoila Ladd"
    },
    "SAC-METRO": {
      "label": "Sacramento Metro & Foothills",
      "market": "SACRAMENTO",
      "color": "#1dffc1",
      "description": "Sacramento-Stockton-Modesto DMA: the Sacramento metro, Stockton and San Joaquin Valley, Modesto/Stanislaus, the Solano and Yolo corridor, and the Sierra foothill counties (Placer, El Dorado, Amador, Calaveras, Tuolumne, Nevada, Plumas, Sierra). 365 Tier 1 ZIPs across 17 counties.",
      "account_manager": "Alex Acuna"
    }
  },
