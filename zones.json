    {
      "rule_id": "milwaukee_market",
      "type": "market_match",
      "match": {
        "market": "MILWAUKEE"
      },
      "assign_zone_id": "Milwaukee + N. IL",
      "description": "Entire Milwaukee market goes to the combined Milwaukee + N. IL zone."
    },
    {
      "rule_id": "northern_il_to_milwaukee",
      "type": "county_list",
      "match": {
        "market": "CHICAGO",
        "state": "Illinois"
      },
      "params": {
        "counties": [
          "Lake County",
          "McHenry County"
        ]
      },
      "assign_zone_id": "Milwaukee + N. IL",
      "description": "Lake & McHenry IL counties go to the Milwaukee zone. MUST evaluate before chicago_central — otherwise these addresses would match the lat band first."
    }
  ],
